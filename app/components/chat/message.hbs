{{! The assistant answers in markdown; the user's own text stays plain. }}
<div
  class="chat-message
    {{if @isAssistant 'chat-message--assistant' 'chat-message--user'}}"
>
  {{#if @isAssistant}}
    {{#if @message.attachments.length}}
      <div class="chat-attachment-tabs">
        <button
          type="button"
          class="chat-attachment-tab
            {{unless this.showAttachments 'chat-attachment-tab--active'}}"
          {{on "click" this.showText}}
        >{{t "dashboard.chat.message"}}</button>
        <button
          type="button"
          class="chat-attachment-tab
            {{if this.showAttachments 'chat-attachment-tab--active'}}"
          {{on "click" this.openAttachments}}
        >{{t
            "dashboard.chat.attachments-count"
            count=@message.attachments.length
          }}</button>
      </div>
    {{/if}}
    {{#if this.showAttachments}}
      {{#each @message.attachments as |document|}}
        <Chat::Attachment @document={{document}} />
      {{/each}}
    {{else}}
      <div class="chat-md">{{this.html}}</div>
      {{#if @message.attachments.length}}
        <AuAlert
          @skin="info"
          @size="small"
          @title={{t "dashboard.chat.attachments-available"}}
        >
          {{t
            "dashboard.chat.attachments-info"
            count=@message.attachments.length
          }}
          <AuButton @skin="link" {{on "click" this.openAttachments}}>{{t
              "dashboard.chat.attachments"
            }}</AuButton>
          {{t "dashboard.chat.attachments-info-after"}}
        </AuAlert>
      {{/if}}
    {{/if}}
  {{else}}
    <div class="chat-message__text">{{@message.content}}</div>
  {{/if}}
</div>