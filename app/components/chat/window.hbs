<div class="chat-window">
  <div
    class="chat-window__messages"
    {{chat-scroll-bottom @conversation.id this.messages.length}}
  >
    {{#unless this.messages.length}}
      <p class="au-u-muted">{{@assistant.description}}</p>
    {{/unless}}

    {{#each this.messages key="id" as |message|}}
      <Chat::Message
        @message={{message}}
        @isAssistant={{this.isAssistant message}}
      />
    {{/each}}

    {{#if this.waitingForAnswer}}
      <AuLoader @inline={{true}}>{{t
          "dashboard.chat.thinking"
          name=@assistant.name
        }}</AuLoader>
    {{/if}}

    {{#if this.answerTimedOut}}
      <AuAlert @skin="warning" @title={{t "dashboard.chat.no-answer"}}>
        {{t "dashboard.chat.no-answer-info"}}
        <AuButton @skin="link" {{on "click" this.refresh}}>{{t
            "dashboard.chat.refresh"
          }}</AuButton>
      </AuAlert>
    {{/if}}

    {{#if this.send.last.isError}}
      <AuAlert
        @skin="error"
        @title={{t "dashboard.chat.error"}}
      >{{this.send.last.error.message}}</AuAlert>
    {{/if}}
  </div>

  <Chat::Composer
    @onSend={{perform this.send}}
    @disabled={{this.waitingForAnswer}}
  />
</div>