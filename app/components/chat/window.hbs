<div class="chat-window">
  <div
    class="chat-window__messages"
    {{chat-scroll-bottom @conversation.id @messages.length}}
  >
    {{#unless @messages.length}}
      <p class="au-u-muted">{{@assistant.description}}</p>
    {{/unless}}

    {{#each @messages key="id" as |message|}}
      <Chat::Message
        @message={{message}}
        @isAssistant={{@isAssistant message}}
      />
    {{/each}}

    {{#if @waitingForAnswer}}
      <AuLoader @inline={{true}}>{{t
          "dashboard.chat.thinking"
          name=@assistant.name
        }}</AuLoader>
    {{/if}}

    {{#if @answerTimedOut}}
      <AuAlert @skin="warning" @title={{t "dashboard.chat.no-answer"}}>
        {{t "dashboard.chat.no-answer-info"}}
        <AuButton @skin="link" {{on "click" @refresh}}>{{t
            "dashboard.chat.refresh"
          }}</AuButton>
      </AuAlert>
    {{/if}}

    {{#if @sendError}}
      <AuAlert
        @skin="error"
        @title={{t "dashboard.chat.error"}}
      >{{@sendError.message}}</AuAlert>
    {{/if}}
  </div>

  <Chat::Composer
    @onSend={{perform @send @conversation}}
    @disabled={{@waitingForAnswer}}
  />
</div>
