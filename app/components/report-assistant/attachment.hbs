<div class="report-assistant-attachment au-u-margin-top-tiny">
  <div class="report-assistant-attachment__info">
    <strong>{{@document.filename}}</strong>
    <span class="report-assistant-attachment__what">{{this.what}}</span>
    {{#if this.isSpec}}
      {{#unless this.findReportSpec.isRunning}}
        {{#if this.reportSpecId}}
          <p class="report-assistant-attachment__hint">{{t
              "dashboard.report-assistant.saved-info"
            }}</p>
          <AuButton
            @loading={{this.run.isRunning}}
            @disabled={{this.run.isRunning}}
            {{on "click" (perform this.run)}}
          >{{t "dashboard.report-assistant.run-report-spec"}}</AuButton>
        {{else}}
          <p class="report-assistant-attachment__hint">{{t
              "dashboard.report-assistant.save-info"
            }}</p>
          <AuButton
            @loading={{this.save.isRunning}}
            @disabled={{this.save.isRunning}}
            {{on "click" (perform this.save)}}
          >{{t "dashboard.report-assistant.save-report-spec"}}</AuButton>
        {{/if}}
      {{/unless}}
    {{/if}}
  </div>
  <a
    href={{download-url @document.id @document.filename}}
    class="au-c-link"
    download={{@document.filename}}
  >
    {{t "dashboard.report-assistant.download"}}
  </a>
</div>