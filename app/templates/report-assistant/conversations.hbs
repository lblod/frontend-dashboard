<div class="report-assistant-overview">
  <div class="report-assistant-overview__toolbar">
    <AuHeading @level="1" @skin="4">
      {{t "dashboard.report-assistant.conversation-history"}}
    </AuHeading>
    <ReportAssistant::NewConversation />
  </div>
  <p class="report-assistant-overview__description">
    {{t "dashboard.report-assistant.conversation-history-description"}}
  </p>
  <ReportAssistant::ConversationTable
    @conversations={{@model}}
    @page={{this.page}}
    @size={{this.size}}
  />
</div>