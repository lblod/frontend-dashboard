<div class="chat-overview">
  <div class="chat-overview__toolbar">
    <AuHeading @level="1" @skin="4">
      {{t "dashboard.chat.conversation-history"}}
    </AuHeading>
    <Chat::NewConversation />
  </div>
  <p class="chat-overview__description">
    {{t "dashboard.chat.conversation-history-description"}}
  </p>
  <Chat::ConversationTable
    @conversations={{@model}}
    @page={{this.page}}
    @size={{this.size}}
  />
</div>
