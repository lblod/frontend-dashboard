<div class="report-assistant-overview report-assistant-help">
  <AuHeading @level="1" @skin="4">
    {{t "dashboard.report-assistant.help-title"}}
  </AuHeading>
  <p class="report-assistant-overview__description">
    {{t "dashboard.report-assistant.help-intro"}}
  </p>

  <section class="report-assistant-help__section">
    <AuHeading @level="2" @skin="5">
      {{t "dashboard.report-assistant.help-steps-title"}}
    </AuHeading>
    <ol class="report-assistant-help__list">
      <li>{{t "dashboard.report-assistant.help-step-1"}}</li>
      <li>{{t "dashboard.report-assistant.help-step-2"}}</li>
      <li>{{t "dashboard.report-assistant.help-step-3"}}</li>
      <li>{{t "dashboard.report-assistant.help-step-4"}}</li>
      <li>{{t "dashboard.report-assistant.help-step-5"}}</li>
    </ol>
  </section>

  <section class="report-assistant-help__section">
    <AuHeading @level="2" @skin="5">
      {{t "dashboard.report-assistant.help-not-title"}}
    </AuHeading>
    <ul class="report-assistant-help__list">
      <li>{{t "dashboard.report-assistant.help-not-1"}}</li>
      <li>{{t "dashboard.report-assistant.help-not-2"}}</li>
      <li>{{t "dashboard.report-assistant.help-not-3"}}</li>
    </ul>
  </section>

  <section class="report-assistant-help__section">
    <AuHeading @level="2" @skin="5">
      {{t "dashboard.report-assistant.help-privacy-title"}}
    </AuHeading>
    <AuAlert
      @skin="info"
      @title={{t "dashboard.report-assistant.help-privacy-alert"}}
    />
    <p class="report-assistant-help__text">
      {{t "dashboard.report-assistant.help-privacy-intro"}}
    </p>
    <div class="report-assistant-help__do-dont">
      <div class="report-assistant-help__do">
        <AuHeading @level="3" @skin="6">
          {{t "dashboard.report-assistant.help-do-title"}}
        </AuHeading>
        <ul class="report-assistant-help__list">
          <li>{{t "dashboard.report-assistant.help-do-1"}}</li>
          <li>{{t "dashboard.report-assistant.help-do-2"}}</li>
          <li>{{t "dashboard.report-assistant.help-do-3"}}</li>
        </ul>
      </div>
      <div class="report-assistant-help__dont">
        <AuHeading @level="3" @skin="6">
          {{t "dashboard.report-assistant.help-dont-title"}}
        </AuHeading>
        <ul class="report-assistant-help__list">
          <li>{{t "dashboard.report-assistant.help-dont-1"}}</li>
          <li>{{t "dashboard.report-assistant.help-dont-2"}}</li>
          <li>{{t "dashboard.report-assistant.help-dont-3"}}</li>
        </ul>
      </div>
    </div>
    <p class="report-assistant-help__text">
      {{t "dashboard.report-assistant.help-privacy-note"}}
    </p>
  </section>

  <section class="report-assistant-help__section">
    <AuHeading @level="2" @skin="5">
      {{t "dashboard.report-assistant.help-good-title"}}
    </AuHeading>
    <ul class="report-assistant-help__list">
      <li>{{t "dashboard.report-assistant.help-good-1"}}</li>
      <li>{{t "dashboard.report-assistant.help-good-2"}}</li>
      <li>{{t "dashboard.report-assistant.help-good-3"}}</li>
    </ul>
  </section>
</div>