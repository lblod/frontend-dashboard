{{#if @model.conversation}}
  <div class="chat-toolbar">
    <AuHeading @level="1" @skin="3" class="chat-toolbar__title">
      {{if
        @model.conversation.title
        @model.conversation.title
        (t "dashboard.chat.new-conversation")
      }}
    </AuHeading>
    <Chat::NewConversation />
  </div>

  {{! Ember keeps a component when only its arguments change. The key gives
      each conversation its own window, so its poll starts in the constructor. }}
  {{#each (array @model.conversation) key="id" as |conversation|}}
    <Chat::Window
      @conversation={{conversation}}
      @assistant={{@model.assistant}}
    />
  {{/each}}
{{else}}
  <div class="chat-start">
    <Chat::NewConversation @large={{true}} />
  </div>
{{/if}}
